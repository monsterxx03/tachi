# Build output. ANCHORED to the repo root on purpose: an unanchored `tachi` also matches
# any DIRECTORY of that name, which silently swallowed the generated frontend bindings
# under desktop/frontend/bindings/github.com/monsterxx03/tachi/ — so they were never
# tracked, and a fresh checkout had to regenerate them before tsc would run.
/tachi
/tachi-linux-amd64
/tachi-linux-arm64
# The no-window host (make headless). Same reasoning: a build artifact at the root, and the
# anchored names keep them from swallowing anything else. The suffix is GOOS-GOARCH.
/tachi-headless
/tachi-headless-*
# go build 不带 -o 时把二进制写到当前目录 —— 在仓库根跑就会留下这个
/mockapi
.DS_Store

# ginkgo -p compiles test binaries into the package dir (itest/run/run.test);
# without ignoring them every ginkgo run dirties the worktree, which defeats
# harness.BuildBinary's shared-binary cache (keyed on a clean worktree).
itest/**/*.test

# Third-party channel plugins (local development only)
third_party_channels.go
go.work
go.work.sum
.tachi

# harbor
__pycache__
terminal-bench-2-1/

# Chrome extension build
chrome-extension/dist/
chrome-extension/*.zip


# Web console frontend
web/frontend/node_modules/
web/frontend/dist/
web/frontend/*.tsbuildinfo

# go build . inside the desktop module writes the module-named binary here
desktop/desktop

# Real-pool tool-search corpus (dumped from a live MCP config; never commit)
pkg/jev/testdata/tool-search/local/
